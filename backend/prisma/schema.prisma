generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  VOLUNTEER
  ASSOCIATE_INSTRUCTOR
}

enum CheckInStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Programme {
  BTECH
  BDES
  MTECH
  PHD
  MSC
  MA
  DUAL_DEGREE
  OTHER
}

enum EventType {
  OPEN_WORKSHOP
  WELLNESS_COURSE
  PLACEMENT_WORKSHOP
  PHD_WORKSHOP
  OTHER
}

enum RegistrationMode {
  COMPULSORY
  OPTIONAL_BUNDLE
  OPEN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum StaffAssignmentRole {
  INSTRUCTOR
  ASSOCIATE_INSTRUCTOR
  VOLUNTEER
}

enum ImportJobType {
  USERS
  EVENT_REGISTRATIONS
  EVENTS
  MARKS
  ATTENDANCE
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoCategory {
  MENTORSHIP
  LEADERSHIP
  WELLNESS
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  DECLINED
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole
  employeeId         String?            @unique
  profileImageUrl    String?
  isActive           Boolean            @default(true)
  isVerified         Boolean            @default(false)
  approvalStatus     ApprovalStatus     @default(APPROVED)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  studentProfile     StudentProfile?
  instructorProfile  InstructorProfile?
  adminProfile       AdminProfile?
  refreshTokens      RefreshToken[]
  createdEvents      Event[]            @relation("EventCreatedBy")
  createdTemplates   EventTemplate[]    @relation("TemplateCreatedBy")
  eventAssignments   EventStaffAssignment[]
  eventAvailability  EventAvailability[]
  registrations      EventRegistration[]
  attendances        AttendanceRecord[]
  attendanceMarked   AttendanceRecord[] @relation("AttendanceMarkedBy")
  checkIns           EventCheckIn[]     @relation("CheckInByUser")
  verifiedCheckIns   EventCheckIn[]     @relation("CheckInVerifiedBy")
  feedbackEntries    Feedback[]
  feedbackResponses  FeedbackResponse[]
  importJobs         ImportJob[]        @relation("ImportCreatedBy")
  emailVerifications EmailVerification[]
  notifications      Notification[]
}

model StudentProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  rollNumber     String      @unique
  department     String
  yearOfStudy    Int
  programme      Programme
  section        String?
  cohort         String?
  joinedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleProgress ModuleProgress[]

  @@index([department, yearOfStudy, programme])
}

model InstructorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  designation    String?
  department     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeId     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EventTemplate {
  id                  String    @id @default(cuid())
  title               String
  description         String
  defaultType         EventType
  quizLink            String?
  feedbackLink        String?
  lockedCoreContent   Boolean   @default(true)
  defaultModules      Json?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           User      @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  events              Event[]
}

model Event {
  id                    String                 @id @default(cuid())
  title                 String
  slug                  String                 @unique
  description           String
  type                  EventType
  status                EventStatus            @default(DRAFT)
  bannerImageUrl        String?
  venue                 String?
  meetLink              String?
  startAt               DateTime
  endAt                 DateTime
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  capacity              Int?
  volunteersNeeded      Int?
  isCampusWide          Boolean                @default(true)
  allowVolunteerSignup  Boolean                @default(true)
  requiresCheckIn       Boolean                @default(true)
  registrationMode      RegistrationMode       @default(OPEN)
  quizLink              String?
  feedbackLink          String?
  createdById           String
  templateId            String?
  courseId              String?
  courseModuleId        String?
  batch                 String?
  // Direct link to a reusable Quiz-library quiz (see Quiz model below) — only
  // meaningful for a standalone event with no courseModuleId, since a
  // course-linked event always inherits its quiz from courseModule.quizId.
  quizId                String?
  // Whether the linked quiz/feedback form is actually required of students —
  // decoupled from quizId/feedbackFormId being set so an admin can flip a
  // toggle on before content is ready. Only meaningful for a standalone event
  // (no courseModuleId); course-linked events inherit both from their module.
  quizApplicable        Boolean                @default(false)
  feedbackApplicable    Boolean                @default(false)
  // Independent toggle for the student-facing star-rating card (legacy
  // Feedback model), decoupled from quiz/feedback library entirely — default
  // true so every existing event keeps its prior always-shown behavior until
  // an admin explicitly turns it off. Only meaningful for a standalone event
  // (no courseModuleId); course-linked events inherit from their module.
  ratingApplicable      Boolean                @default(true)
  // Direct link to a reusable Feedback-library form (see FeedbackForm model
  // below) — same standalone-only/inherit-from-module rule as quizId.
  feedbackFormId        String?
  completionEmailSentAt DateTime?
  reminder24hSentAt     DateTime?
  reminder1hSentAt      DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             User                   @relation("EventCreatedBy", fields: [createdById], references: [id])
  template              EventTemplate?         @relation(fields: [templateId], references: [id])
  course                Course?                @relation("EventCourse", fields: [courseId], references: [id], onDelete: SetNull)
  courseModule          CourseModule?          @relation("EventFromModule", fields: [courseModuleId], references: [id], onDelete: SetNull)
  quiz                  Quiz?                  @relation(fields: [quizId], references: [id], onDelete: SetNull)
  feedbackForm          FeedbackForm?          @relation(fields: [feedbackFormId], references: [id], onDelete: SetNull)
  modules               EventModule[]
  registrations         EventRegistration[]
  assignments           EventStaffAssignment[]
  availabilityResponses EventAvailability[]
  checkIns              EventCheckIn[]
  attendances           AttendanceRecord[]
  feedbackEntries       Feedback[]
  feedbackResponses     FeedbackResponse[]

  @@index([status, startAt])
  @@index([type, startAt])
  @@index([courseId])
  @@index([courseModuleId])
  @@index([quizId])
  @@index([feedbackFormId])
}

model EventModule {
  id                 String            @id @default(cuid())
  eventId            String
  title              String
  description        String?
  venue              String?
  meetLink           String?
  startAt            DateTime
  endAt              DateTime
  maxMarks           Int?
  quizLink           String?
  feedbackLink       String?
  // Set only on the EventModule auto-created to hold an in-built Quiz's
  // submission for this event — lets score-recording target exactly that
  // module instead of colliding with real pre-existing EventModules (from
  // templates/bulk MARKS import) or the legacy Google-Form quiz path, which
  // both pick modules by other means (earliest startAt, moduleTitle, etc.).
  sourceQuizId       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  progressEntries    ModuleProgress[]
  attendances        AttendanceRecord[]
  checkIns           EventCheckIn[]

  @@unique([eventId, sourceQuizId])
  @@index([eventId, startAt])
}

model EventRegistration {
  id                 String              @id @default(cuid())
  eventId            String
  userId             String
  status             RegistrationStatus  @default(REGISTERED)
  isVolunteer        Boolean             @default(false)
  registeredAt       DateTime            @default(now())
  checkedInAt        DateTime?
  notes              String?
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, registeredAt])
  @@index([eventId, status])
}

model EventStaffAssignment {
  id                 String               @id @default(cuid())
  eventId            String
  userId             String
  role               StaffAssignmentRole
  assignedById       String?
  notes              String?
  createdAt          DateTime             @default(now())
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, role])
  @@index([userId, role])
}

model EventAvailability {
  id                 String   @id @default(cuid())
  eventId            String
  userId             String
  isAvailable        Boolean
  note               String?
  respondedAt        DateTime @default(now())
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, isAvailable])
}

model EventCheckIn {
  id                 String        @id @default(cuid())
  eventId            String
  moduleId           String?
  userId             String
  status             CheckInStatus @default(PENDING)
  checkedInAt        DateTime      @default(now())
  note               String?
  verifiedById       String?
  event              Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  module             EventModule?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user               User          @relation("CheckInByUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy         User?         @relation("CheckInVerifiedBy", fields: [verifiedById], references: [id])

  @@index([eventId, userId, checkedInAt])
  @@index([moduleId, status])
}

model ModuleProgress {
  id                 String      @id @default(cuid())
  studentProfileId   String
  moduleId           String
  marksObtained      Float?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  module             EventModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizAnswers        QuizAnswer[]

  @@unique([studentProfileId, moduleId])
  @@index([studentProfileId, completedAt])
}

model AttendanceRecord {
  id                 String           @id @default(cuid())
  eventId            String
  moduleId           String?
  userId             String
  status             AttendanceStatus
  markedById         String?
  markedAt           DateTime         @default(now())
  source             String?
  event              Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  module             EventModule?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  markedBy           User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@index([eventId, status])
  @@index([moduleId, userId])
}

model Feedback {
  id                 String    @id @default(cuid())
  eventId            String
  userId             String
  eventRating        Int
  instructorRating   Int?
  eventComment       String?
  instructorComment  String?
  createdAt          DateTime  @default(now())
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, eventRating])
}

model ImportJob {
  id                 String          @id @default(cuid())
  type               ImportJobType
  status             ImportJobStatus @default(PENDING)
  fileName           String
  fileUrl            String?
  meta               Json?
  result             Json?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          User            @relation("ImportCreatedBy", fields: [createdById], references: [id])

  @@index([type, status])
}

model Video {
  id                 String        @id @default(cuid())
  title              String
  description        String
  youtubeUrl         String
  thumbnailUrl       String?
  duration           String
  category           VideoCategory
  tags               String[]
  isActive           Boolean       @default(true)
  viewCount          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([category])
  @@index([isActive])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  eventId     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model EmailVerification {
  id                 String    @id @default(cuid())
  userId             String
  otp                String
  expiresAt          DateTime
  attempts           Int       @default(0)
  isUsed             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([otp, isUsed])
}

model Course {
  id                 String        @id @default(cuid())
  name               String
  code               String?
  description        String
  posterUrl          String?
  duration           String?
  instructorName     String?
  status             CourseStatus  @default(ACTIVE)
  isCompulsory       Boolean       @default(false)
  // Whether the in-built MCQ quiz (always 10 questions, distinct from the
  // legacy Google-Form quiz.service.js webhook) is meant to be used for this
  // course's modules — drives Pass/Fail grading in admin Analytics. Separate
  // from isCompulsory: compulsory bundle courses don't all have a quiz.
  hasQuiz            Boolean       @default(false)
  startDate          DateTime?
  endDate            DateTime?
  capacity           Int?
  enrolledCount      Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  modules            CourseModule[]
  events             Event[]       @relation("EventCourse")
  batchAssignments   BatchAssignment[]

  @@index([status])
  @@index([startDate])
}

model CourseModule {
  id              String    @id @default(cuid())
  courseId        String
  title           String
  description     String?
  posterUrl       String?
  quizLink        String?
  feedbackLink    String?
  duration        String?
  order           Int       @default(0)
  isActive        Boolean   @default(true)
  // Link into the reusable Quiz library (see Quiz model below) — nullable so
  // a module can be created and scheduled before quiz content is ready, and
  // attached later. Every per-batch Event instantiated from this module
  // (sharing this courseModuleId) resolves to the SAME quiz via this field.
  quizId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Same decoupled-toggle + reference-to-Feedback-library pattern as the Quiz
  // fields above.
  quizApplicable     Boolean       @default(false)
  feedbackApplicable Boolean       @default(false)
  feedbackFormId     String?
  // Same independent rating toggle as Event.ratingApplicable above — default
  // true to preserve existing always-shown behavior for every module.
  ratingApplicable   Boolean       @default(true)

  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  events          Event[]   @relation("EventFromModule")
  batchAssignments BatchAssignment[]
  quiz            Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  feedbackForm    FeedbackForm? @relation(fields: [feedbackFormId], references: [id], onDelete: SetNull)

  @@index([courseId, order])
  @@index([isActive])
  @@index([quizId])
  @@index([feedbackFormId])
}

// A reusable, fixed 10-question MCQ quiz — created independently in the admin
// "Forms" library and then LINKED (by reference, not copy) to any number of
// CourseModules and/or standalone Events via their quizId field. Editing a
// quiz's questions here updates it everywhere it's linked. Deleting a quiz
// that's still linked anywhere is blocked in the service layer (see
// quizLibrary.service.js) — onDelete: SetNull below is just a DB-level
// backstop, not the primary safeguard.
model Quiz {
  id             String   @id @default(cuid())
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questions     QuizQuestion[]
  courseModules CourseModule[]
  events        Event[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  order         Int
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // "A" | "B" | "C" | "D"

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, order])
}

// Per-question record of what a student picked on quiz submission — added
// after discovering submitMyQuiz computed the score from the submitted
// answers array and then discarded it, so only the aggregate score was ever
// recoverable (see ModuleProgress.marksObtained). This only captures
// answers from submissions made after this model was added; nothing here
// for quizzes submitted earlier, since that data was never persisted.
model QuizAnswer {
  id                String  @id @default(cuid())
  moduleProgressId  String
  quizQuestionId    String
  selectedOption    String  // "A" | "B" | "C" | "D"
  isCorrect         Boolean

  moduleProgress ModuleProgress @relation(fields: [moduleProgressId], references: [id], onDelete: Cascade)
  quizQuestion   QuizQuestion   @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)

  @@unique([moduleProgressId, quizQuestionId])
}

enum FeedbackQuestionType {
  TEXT
  RATING
  MCQ
}

// Reusable, flexible-length, mixed-type feedback form — same reference
// architecture as Quiz above: authored once in the Forms library, linked by
// reference into any number of CourseModules/Events. Unlike Quiz, there is no
// scoring/correct-option here — this is student-reported feedback, not an
// assessment. Deleting a form that's still linked anywhere is blocked in the
// service layer (see feedbackLibrary.service.js) — onDelete: SetNull below is
// just a DB-level backstop, not the primary safeguard.
model FeedbackForm {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     FeedbackQuestion[]
  responses     FeedbackResponse[]
  courseModules CourseModule[]
  events        Event[]
}

model FeedbackQuestion {
  id             String               @id @default(cuid())
  feedbackFormId String
  order          Int
  questionText   String
  type           FeedbackQuestionType
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?

  feedbackForm FeedbackForm     @relation(fields: [feedbackFormId], references: [id], onDelete: Cascade)
  answers      FeedbackAnswer[]

  @@index([feedbackFormId, order])
}

// One student's completed submission of a form for one event — mirrors how
// ModuleProgress.completedAt gates quiz double-submit, but dedicated (no
// scoring concept to piggyback on).
model FeedbackResponse {
  id             String   @id @default(cuid())
  feedbackFormId String
  eventId        String
  userId         String
  submittedAt    DateTime @default(now())

  feedbackForm FeedbackForm     @relation(fields: [feedbackFormId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      FeedbackAnswer[]

  @@unique([eventId, userId])
  @@index([feedbackFormId])
}

model FeedbackAnswer {
  id                 String  @id @default(cuid())
  feedbackResponseId String
  feedbackQuestionId String
  answerText         String? // TEXT questions, and the selected letter for MCQ
  answerRating       Int?    // RATING questions (1-5)

  feedbackResponse FeedbackResponse @relation(fields: [feedbackResponseId], references: [id], onDelete: Cascade)
  feedbackQuestion FeedbackQuestion @relation(fields: [feedbackQuestionId], references: [id], onDelete: Cascade)

  @@unique([feedbackResponseId, feedbackQuestionId])
}

model BatchAssignment {
  id             String   @id @default(cuid())
  email          String?
  rollNumber     String?
  batchCode      String
  name           String?
  department     String?
  programme      String?
  yearOfStudy    Int?
  section        String?
  courseId       String?
  // Nullable: a course whose students use ONE batch code for the whole
  // course (existing behaviour) leaves this null. A course where the same
  // student has a DIFFERENT batch per module (e.g. M1B1 for Module A, M2B3
  // for Module B) sets this so each module's assignment is its own row
  // instead of one row per (courseId, student) that the next module's
  // upload silently overwrites.
  courseModuleId String?
  isMatched      Boolean  @default(false)
  matchedUserId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course         Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseModule   CourseModule? @relation(fields: [courseModuleId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([rollNumber])
  @@index([batchCode])
  @@index([isMatched])
  @@index([courseId])
  @@index([courseModuleId])
}
